# Arguments are checked against the schema before the closure runs; a failure is a tool error the model can fix.
> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"claude-code","version":"2.0.0"}}}
< {"jsonrpc":"2.0","id":1,"result":"*"}
> {"jsonrpc":"2.0","method":"notifications/initialized"}
> {"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"read_note","arguments":{}}}
< {"jsonrpc":"2.0","id":2,"result":{"content":[{"type":"text","text":"missing required argument 'path'"}],"isError":true}}
> {"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"read_note","arguments":{"path":3}}}
< {"jsonrpc":"2.0","id":3,"result":{"content":[{"type":"text","text":"argument 'path' must be of type string"}],"isError":true}}
> {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"read_note","arguments":{"path":"a.md","x":1}}}
< {"jsonrpc":"2.0","id":4,"result":{"content":[{"type":"text","text":"unknown argument 'x'; arguments: path"}],"isError":true}}
> {"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"read_note"}}
< {"jsonrpc":"2.0","id":5,"result":{"content":[{"type":"text","text":"missing required argument 'path'"}],"isError":true}}
# Arguments that are not an object break the request's shape: a protocol error.
> {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"read_note","arguments":"x"}}
< {"jsonrpc":"2.0","id":6,"error":{"code":-32602,"message":"tools/call arguments must be an object"}}
